{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "baawastaken",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/yt-thumb/*"]
  }
}
