# Applies to every static file. (The homepage's HTML also passes through here before the Worker adds the latest video.)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built files have a hash in their name, so they can be cached for good.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Icons and the share image keep the same name when they change, so cache them for a day.
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-32.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og.png
  Cache-Control: public, max-age=86400
