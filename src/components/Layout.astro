---
import '../styles/global.css';
import { site } from '../data/site';
import wordmark from '@fontsource/jersey-20/files/jersey-20-latin-400-normal.woff2?url';

interface Props {
  /** Overrides the default title (used by the 404 page). */
  title?: string;
  /** Keep the page out of search results. */
  noindex?: boolean;
}

const { title = site.title, noindex = false } = Astro.props;
const image = new URL('/og.png', site.canonicalUrl).href;
const imageAlt = 'baawastaken: a cozy pixel-art room with shelves of links to every channel';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={site.description} />
    <meta name="theme-color" content={site.themeColor} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={site.canonicalUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={wordmark} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={site.canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
  </head>
  <body>
    <slot />
  </body>
</html>
